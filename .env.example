# Optional: without keys AegisAI runs fully offline with deterministic fallbacks.
ANTHROPIC_API_KEY=
# auto | claude | openai | offline
AEGIS_PROVIDER=auto
AEGIS_MODEL_FAST=claude-haiku-4-5-20251001
AEGIS_MODEL_STRONG=claude-sonnet-5
# memory (in-process MCP sessions) | stdio (MCP servers as subprocesses)
AEGIS_MCP_TRANSPORT=memory
# Run specialists as separate A2A services, e.g. observability=http://localhost:9101
AEGIS_REMOTE_AGENTS=
AEGIS_DATA_DIR=./.aegis
